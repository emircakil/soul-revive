<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SoulsRevive</AssemblyName>
    <RootNamespace>SoulsRevive</RootNamespace>
    <AssemblyVersion>1.3.0.0</AssemblyVersion>
    <FileVersion>1.3.0.0</FileVersion>
    <Product>Soul Revive</Product>
    <Description>Pixel bonfire desktop companion for Windows, macOS, and Linux</Description>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <TieredCompilation>true</TieredCompilation>
    <DefineConstants>$(DefineConstants);PORTABLE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Raylib-cs" Version="[8.1.0]" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\assets\fonts\VT323-Regular.ttf" LogicalName="PixelFont.ttf" />
    <EmbeddedResource Include="..\assets\fonts\VT323-OFL.txt" Link="VT323-OFL.txt" />
    <EmbeddedResource Include="..\assets\app-icon.png" LogicalName="AppIcon.png" />
    <Compile Include="../src/Core.cs" Link="Shared/Core.cs" />
    <Compile Include="../src/DayCycle.cs" Link="Shared/DayCycle.cs" />
    <Compile Include="../src/PixelArt.cs" Link="Shared/PixelArt.cs" />
    <Compile Include="../src/Equipment.cs" Link="Shared/Equipment.cs" />
    <Compile Include="../src/Tavern.cs" Link="Shared/Tavern.cs" />
    <Compile Include="../src/WorkAnimations.cs" Link="Shared/WorkAnimations.cs" />
  </ItemGroup>

</Project>
