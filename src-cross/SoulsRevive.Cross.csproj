<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>SoulsRevive</AssemblyName>
    <RootNamespace>SoulsRevive</RootNamespace>
    <AssemblyVersion>1.3.0.0</AssemblyVersion>
    <FileVersion>1.3.0.0</FileVersion>
    <Product>Soul Revive</Product>
    <Description>Pixel bonfire desktop companion for Windows, macOS, and Linux</Description>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <TieredCompilation>true</TieredCompilation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Raylib-cs" Version="8.1.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\assets\fonts\VT323-Regular.ttf" Link="VT323-Regular.ttf" />
    <EmbeddedResource Include="..\assets\fonts\VT323-OFL.txt" Link="VT323-OFL.txt" />
  </ItemGroup>

</Project>
